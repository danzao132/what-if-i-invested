# Which market-data provider to use: yahoo (default, keyless, personal/dev use only),
# tiingo (licensed, needs TIINGO_API_KEY) or fixtures (bundled demo snapshot, offline).
MARKET_DATA_PROVIDER=yahoo
TIINGO_API_KEY=
# Fall back to the clearly-labelled demo snapshot if the live provider fails ("off" to disable).
DEMO_FALLBACK=on
# Public URL, used for Open Graph/Twitter image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
